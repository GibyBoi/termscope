{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TermScope 3 Dev",
  "version": "3.3.0",
  "identifier": "com.0xygenbreather.termscope.dev",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TermScope 3 Dev",
        "width": 960,
        "height": 620,
        "minWidth": 860,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../data/terms_tech.json": "data/terms_tech.json",
      "../data/terms_business.json": "data/terms_business.json",
      "../data/terms_companies.json": "data/terms_companies.json",
      "../data/filler_words.json": "data/filler_words.json",
      "../data/library.json": "data/library.json",
      "../sidecar/listen.py": "sidecar/listen.py"
    }
  }
}
